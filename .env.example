MEMORY_ENABLED=true
MEMORY_AUTO_STORE_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=agent_memory
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_LOCAL_FILES_ONLY=true
MEMORY_DEFAULT_TOP_K=8
MEMORY_MAX_CONTEXT_ITEMS=10
MEMORY_MIN_SIMILARITY=0.45
MEMORY_AUTO_STORE_CONFIDENCE=0.90
MEMORY_AUTO_STORE_IMPORTANCE=0.70

# Verbose execution tracing (written under logs/; console remains minimal).
PIPEGENT_LOG_LEVEL=DEBUG
PIPEGENT_LOG_TO_CONSOLE=false
PIPEGENT_LOG_MAX_VALUE_CHARS=50000
PIPEGENT_LOG_MAX_BYTES=10485760
PIPEGENT_LOG_BACKUP_COUNT=3
PIPEGENT_REASONING_EFFORT=minimal
PIPEGENT_RESPONSE_VERBOSITY=low
PIPEGENT_SYNTHESIZE_FINAL_RESPONSE=false
